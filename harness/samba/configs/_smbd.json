{
  // The Samba server this suite stands up (harness/samba/run_samba_mbt.sh):
  // a disposable smbd from the devcontainer's Ubuntu, SMB2 dialect 0x0300,
  // with `oplocks = no`, `level2 oplocks = no`, `kernel oplocks = no` and
  // `durable handles = no` in its generated smb.conf.  Every caching grant is
  // therefore off, which is the deterministic filesystem core: the CREATE
  // disposition/type matrix, share arbitration, byte-range locks, I/O,
  // delete-on-close, rename, compound threading and CHANGE_NOTIFY, with no
  // oplock/lease break lifecycle interleaved with it.
  //
  // This file carries the SERVER, not a corpus: it declares no batches and is
  // never registered as a cell.  Each flavour extends it and adds the one
  // batch that cell replays, so a divergence names the flavour that found it
  // and the cells run concurrently under `ctest -j`.
  "family": "smb2",
  "description": "the smbd harness/samba stands up: SMB 3.0.0, oplocks / level2 oplocks / kernel oplocks / durable handles all off.",
  "traceStem": "smb2Base",

  "features": {
    "oplocks": "unsupported",
    "leases": "unsupported",
    "dirLeases": "unsupported",
    "durable": "unsupported"
  },

  "policies": {
    // 0x0300 -- smbprotocol's Dialects.SMB_3_0_0, what smb2_wire.py negotiates
    "dialect": 768,
    "leaseOpenBreak": true,
    "forceLevel2": false
  },

  // The Samba divergences the model is told to PREDICT, so the trace's
  // expectation is already what this smbd does and replay is an exact match.
  // Declared with their measurements and citations in
  // ext/specs/quint/smb2/corpus.schema.json; each cell below switches off the
  // ones its own flavour cannot reach, because tools/devliveness.py fails a
  // cell that enables a deviation its corpus never exercises.
  "deviations": [
    "SD-2",
    "SD-4",
    "SD-5",
    "SD-8",
    "SD-9"
  ]
}
