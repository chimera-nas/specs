{
  // The Windows SMB server this suite configures (harness/windows/
  // run_windows_mbt.ps1): the in-box LanmanServer of the runner it executes on
  // -- Windows Server 2025 and Windows 11 in CI -- serving an NTFS directory,
  // spoken to at SMB 3.0.0, with leasing turned off (EnableLeasing).
  //
  // Oplocks are a different matter: Windows cannot turn SMB2 oplocks off
  // (EnableOplocks governs SMB1 only), so this server DOES grant one to a
  // CREATE that asks.  "oplocks: unsupported" below is therefore true only of
  // flavours that never ask, which is every flavour registered here -- the one
  // that does ask, stepReq, is left out for exactly that reason.  What is
  // exercised is the deterministic filesystem core: the CREATE
  // disposition/type matrix, share arbitration, byte-range locks, I/O,
  // delete-on-close, rename and CHANGE_NOTIFY, with no break lifecycle
  // interleaved with it.
  //
  // The same profile harness/samba/configs/_smbd.json describes, on purpose:
  // the two servers are then asked exactly the same questions, and what
  // distinguishes the cells is only which divergences the model is told to
  // predict.
  //
  // This file carries the SERVER, not a corpus: it declares no batches and is
  // never registered as a cell.  Each flavour extends it and adds the one
  // batch that cell replays.
  "family": "smb2",
  "description": "the Windows SMB server harness/windows configures: SMB 3.0.0, oplocks and leasing off.",
  "traceStem": "smb2Base",

  "features": {
    "oplocks": "unsupported",
    "leases": "unsupported",
    "dirLeases": "unsupported",
    "durable": "unsupported"
  },

  "policies": {
    // 0x0300 -- smbprotocol's Dialects.SMB_3_0_0, what smb2_wire.py negotiates
    "dialect": 768,
    "leaseOpenBreak": true,
    "forceLevel2": false,

    // Where implementations of the same documents differ, which arm this one
    // takes.  Each is declared, with what was measured, in
    // quint/smb2/corpus.schema.json.
    //
    // No GrantedAccess check on LOCK: a handle with neither FILE_READ_DATA nor
    // FILE_WRITE_DATA locks and unlocks like any other.
    "lockAccessCheck": false,
    // FILE_SUPERSEDE of an existing file arbitrates for DELETE, not WRITE.
    "supersedeWantsDelete": true,
    // FILE_CREATE onto an existing directory opened FILE_NON_DIRECTORY_FILE
    // reports FILE_IS_A_DIRECTORY rather than the collision.
    "createTypeFirst": true
  },

  // Deviations are for what the server gets WRONG.  Nothing found so far is:
  // every difference from the model's defaults is a policy above.
  "deviations": []
}
