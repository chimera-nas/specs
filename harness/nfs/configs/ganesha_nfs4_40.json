{
  "extends": "./ganesha_nfs4_41.json",
  "description": "The same ganesha at plain NFSv4.0 -- no sessions, so SETCLIENTID/SETCLIENTID_CONFIRM, per-owner seqids and OPEN_CONFIRM carry the state machine instead. Mirrors chimera's nfs4_memfs40 cell.",
  "traceStem": "ganesha40",

  // At 4.0 NFS4ERR_WRONG_TYPE does not exist, so S4-no-wrong-type has nothing
  // to rewrite; EXCHANGE_ID and BIND_CONN_TO_SESSION are 4.1+ operations; and
  // OPEN4_RESULT_CONFIRM is not inert here, it drives the handshake, so the
  // rflagsConfirm tolerance has to come off too.  What 4.0 adds instead is the
  // open-owner sequence, which is where the seqid deviation lives.
  "deviationsOff": [
    "S4-no-wrong-type",
    "G4-exchange-id-no-confirmed-r",
    "G4-bindconn-direction-accepted"
  ],
  "deviations": [
    "S4-owner-seqid-gap-unpoliced",
    // Only the 4.0 walk sends the 256-byte NLONG compound tag (measured with
    // tools/devliveness.py), so this is the one profile that can prove it.
    "G4-compound-tag-length-limit"
  ],

  "tolerances": {
    "rflagsConfirm": false,
    "renewLapsed": true
  },

  "policies": {
    "minor": 0
  }
}
