{
  "family": "nfs4",
  "description": "The Linux kernel NFS server at NFSv4.2, exporting ext4 inside the kvm-test-base guest the harness boots. The feature and policy knobs mirror chimera's nfs4_memfs42 cell exactly, so a difference between the two corpora is a difference in what the two servers do and nothing else.",
  "traceStem": "knfsd42",

  "features": {
    "pnfs": "unsupported",
    "readDelegation": "unsupported",
    "writeDelegation": "unsupported",
    "xattr": "supported",
    "sparse": "supported",
    "copy": "supported",
    "readPlus": "supported",
    "ioAdvise": "supported",
    "writeSame": "supported",
    "clone": "supported"
  },

  // Every id is declared, with its citation and the registry entry it
  // replaces, in ext/specs/quint/nfs4/corpus.schema.json.  Four of the five
  // are S4-*: divergences this server SHARES with NFS-Ganesha, which is the
  // evidence that the clause is ambiguous rather than that one server has a
  // bug.
  "deviations": [
    "S4-compound-tag-unvalidated",
    "S4-change-is-coarse-ctime"
  ],

  // holeTracking: ext4 has a real allocation map, and RFC 7862 15.11 lets a
  // server answer SEEK more precisely than the model's block-granular view.
  "tolerances": {
    "holeTracking": true
  },

  "policies": {
    // This cell is a ROOT export: run_nfs_mbt.sh gives ganesha
    // "Pseudo = /" and knfsd "fsid=0", so PUTROOTFH lands on the export
    // itself and the model's ROOT is the root of the namespace served --
    // LOOKUPP there has no parent.  chimera's memfs cells are NAMED
    // exports and take the other shape; see P_ROOT_EXPORT.
    "rootExport": true,
    "minor": 2,
    "conflictDelays": true,
    "closeFreesLocks": true,
    "layoutWholeFile": true
  },

  "batches": [
    { "flavor": "step",          "steps": 80, "traces": 8, "seed": "0x7" },
    { "flavor": "stepState",     "steps": 80, "traces": 8, "seed": "0x7" },
    { "flavor": "stepNamespace", "steps": 80, "traces": 8, "seed": "0x7" },
    { "flavor": "stepData",      "steps": 80, "traces": 8, "seed": "0x7" },
    { "flavor": "stepTypes",     "steps": 80, "traces": 6, "seed": "0x7" },
    { "flavor": "stepData42",    "steps": 80, "traces": 8, "seed": "0x7" }
  ]
}
