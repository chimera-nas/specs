{
  "family": "nfs4",
  "description": "The same Linux kernel server at NFSv4.1: sessions and the slot replay discipline, with none of the 4.2 data operations. Mirrors chimera's nfs4_memfs41 cell for features and policies.",
  "traceStem": "knfsd41",

  "features": {
    "pnfs": "unsupported",
    "readDelegation": "unsupported",
    "writeDelegation": "unsupported",
    "xattr": "unsupported",
    "sparse": "unsupported",
    "copy": "unsupported",
    "readPlus": "unsupported",
    "ioAdvise": "unsupported",
    "writeSame": "unsupported",
    "clone": "unsupported"
  },

  // K4-rename-symlink-notdir is NOT enabled here even though knfsd has it:
  // measured with tools/devliveness.py, no trace this profile generates ever
  // RENAMEs through a symbolic-link directory handle -- only the 4.0 walk does
  // -- so enabling it would be a claim the corpus cannot prove.  It is on in
  // the 4.0 cell instead.
  "deviations": [
    "S4-no-wrong-type",
    "S4-compound-tag-unvalidated",
    "S4-link-dir-notdir",
    "S4-change-is-coarse-ctime"
  ],

  "policies": {
    "minor": 1,
    "conflictDelays": true,
    "closeFreesLocks": true,
    "layoutWholeFile": true
  },

  "batches": [
    { "flavor": "step",          "steps": 80, "traces": 8, "seed": "0x7" },
    { "flavor": "stepState",     "steps": 80, "traces": 8, "seed": "0x7" },
    { "flavor": "stepNamespace", "steps": 80, "traces": 8, "seed": "0x7" },
    { "flavor": "stepData",      "steps": 80, "traces": 8, "seed": "0x7" },
    { "flavor": "stepTypes",     "steps": 80, "traces": 6, "seed": "0x7" }
  ]
}
