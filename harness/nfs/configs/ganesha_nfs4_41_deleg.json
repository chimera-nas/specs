{
  "extends": "./ganesha_nfs4_41.json",
  "description": "The 4.1 ganesha with delegations SERVED: identical capabilities, but both delegation features asserted so the grant / recall / return lifecycle is generated rather than assumed absent. The stepDeleg flavor drives that lifecycle and nothing else.",
  "traceStem": "ganesha41Deleg",

  "features": {
    "readDelegation": "supported",
    "writeDelegation": "supported"
  },

  // A delegation-only corpus reaches almost none of the parent's divergences,
  // and an enabled-but-unexercised deviation fails tools/devliveness.py.
  "deviationsOff": [
    // measured with tools/devliveness.py: this flavour never sends a
    // compound whose first operation is not SEQUENCE.
    "G4-op-outside-session-no-result",
    "S4-no-wrong-type",
    "G4-compound-tag-length-limit",
    "G4-verify-wide-trivial-match",
    "G4-setattr-share-denied",
    "G4-exchange-id-no-confirmed-r",
    "G4-open-type-before-exist",
    "G4-bindconn-direction-accepted"
  ],

  "batches": [
    { "flavor": "stepDeleg", "steps": 80, "traces": 10, "seed": "0x7" }
  ]
}
