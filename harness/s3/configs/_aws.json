{
  // Amazon S3 itself, as harness/s3/run_aws_mbt.sh reaches it: one bucket
  // that already exists, through credentials that hold rights on that bucket
  // and nothing else.
  //
  // This file carries the SERVICE, not a corpus: it declares no batches and is
  // never registered as a cell.  Each cell extends it and adds its batch list.
  "family": "s3",
  "description": "Amazon S3, one existing bucket.",

  "policies": {
    // The tester cannot create, delete or list buckets, and shares the one it
    // has with other pipelines.  So the model starts with its one bucket live
    // and never draws those calls, nor the bucket-level tagging calls, whose
    // state no key prefix can keep apart.  This narrows what the corpus
    // contains; it changes nothing the model predicts.
    "fixedBucket": true,

    // Where Amazon S3 takes the other arm from the model's default.  Each is
    // declared, with what was measured, in quint/s3/corpus.schema.json.
    //
    // A 416 carries no Content-Range header.
    "rangeErrorContentRange": false,
    // bytes=-N against a zero-length object answers 200 with an empty body.
    "emptySuffixRangeOk": true,
    // With a delimiter, a common prefix the start key lies inside is never
    // returned.
    "listSkipsMarkerPrefix": true,
    // A copy of an object onto itself is performed and answers 200.
    "copySelfOk": true
  },

  // AWS is what the model states.  A difference found here is a model bug
  // until shown otherwise, and none is recorded.
  "deviations": []
}
