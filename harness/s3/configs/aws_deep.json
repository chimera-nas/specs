{
  "extends": "./_aws.json",
  "family": "s3",
  "description": "Amazon S3 over the depth of the modeled calls: listings cut into pages and resumed by continuation token, the max-keys edges, and metadata and tags by every route an object can acquire them. In the one shared bucket.",
  "traceStem": "awsdeep",

  "policies": {
    "fixedBucket": true,
    // THIS bucket performs a copy of an object onto itself; a bucket as AWS
    // creates one refuses it.  See copySelfAccepted in the schema.
    "copySelfAccepted": true
  },

  "batches": [
    { "flavor": "stepPage", "steps": 128, "traces": 5, "seed": "0x1" },
    { "flavor": "stepMeta", "steps": 128, "traces": 5, "seed": "0x1" },
    { "flavor": "stepCond",    "steps": 128, "traces": 4, "seed": "0x1" },
    { "flavor": "stepInvalid", "steps": 96,  "traces": 3, "seed": "0x1" },
    { "flavor": "stepWire",    "steps": 128, "traces": 4, "seed": "0x1" }
  ]
}
