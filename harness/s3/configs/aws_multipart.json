{
  "extends": "./_aws.json",
  "family": "s3",
  "description": "Amazon S3 driven through multipart upload, at the 5 MiB minimum part size the model's EntityTooSmall encoding assumes.",
  "traceStem": "awsmp",

  "policies": {
    // The credentials for this cell hold rights on ONE bucket that already
    // exists and is shared with other pipelines.  So the model starts with its
    // one bucket live and never draws CreateBucket, DeleteBucket, ListBuckets
    // or the bucket-level tagging calls, whose state no key prefix can keep
    // apart.  This narrows what the corpus contains; it changes nothing the
    // model predicts.  The bucket cells cover what this leaves out.
    "fixedBucket": true,
    // THIS bucket performs a copy of an object onto itself; a bucket as AWS
    // creates one refuses it.  See copySelfAccepted in the schema.
    "copySelfAccepted": true
  },

  // The block size is a harness setting (SPECS_S3_BLOCK_SIZE, set by CMake);
  // recorded here as the fact that distinguishes this corpus from the base one.
  "blockSize": 5242880,

  "batches": [
    { "flavor": "stepMultipart", "steps": 64, "traces": 3, "seed": "0x1" },
    { "flavor": "stepMultipart", "steps": 64, "traces": 2, "seed": "0x11" }
  ]
}
